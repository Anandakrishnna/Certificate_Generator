# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Local Development (Zero-setup SQLite):
DATABASE_URL="file:./dev.db"

# Production Serverless Deployment (Vercel, AWS Lambda, Netlify):
# DO NOT use "file:..." on serverless! Serverless filesystems are ephemeral.
# Use a persistent hosted PostgreSQL (Neon, Supabase, AWS RDS) or libSQL/Turso:
# DATABASE_URL="postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# SECURITY & AUTHENTICATION SECRETS
# ==========================================
# JWT Auth Secret (used for signing session cookies)
JWT_SECRET="certifyflow_super_secret_jwt_key_2026_secure"

# AES-256 Secret (used to encrypt organizer SMTP passwords at rest)
ENCRYPTION_KEY="certifyflow_secure_aes256_encryption_key_at_rest"

# ==========================================
# SYSTEM-WIDE EMAIL DELIVERY (OPTIONAL FALLBACK)
# ==========================================
# Note: Organizers can connect their personal Gmail directly via the UI console.
# Standard SMTP (Gmail, Outlook, Yahoo, Brevo, SendGrid, etc.):
# For Gmail: Use full email and 16-character Google App Password (not account password).
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CertifyFlow <noreply@certifyflow.com>"

# Alternative: Resend API
# RESEND_API_KEY="re_123456789"
# RESEND_FROM="Certificates <onboarding@resend.dev>"
